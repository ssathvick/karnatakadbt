{
  "openapi": "3.1.0",
  "info": {
    "title": "KarnatakaDBT Local Partner Simulation",
    "version": "1.0.0",
    "description": "Simulation contracts only. NOT official NIMC, NASSCO, NIBSS, bank or treasury schemas. Fixed synthetic fixtures. Uses platform staff sessions and form CSRF. Amounts are integer kobo; settlement and payment acceptance are separate."
  },
  "servers": [
    {
      "url": "/registration"
    }
  ],
  "paths": {
    "/api/simulation/partners/identity": {
      "post": {
        "security": [
          {
            "staffSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "csrf": {
                    "type": "string"
                  },
                  "scenario": {
                    "type": "string",
                    "enum": [
                      "success",
                      "identity_mismatch",
                      "ineligible",
                      "invalid_account",
                      "insufficient_funds",
                      "payment_failed",
                      "delayed_settlement",
                      "reconciliation_mismatch",
                      "reversal"
                    ]
                  }
                },
                "required": [
                  "csrf",
                  "scenario"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verified": {
                      "type": "boolean"
                    },
                    "identity_reference": {
                      "type": "string"
                    },
                    "consent_reference": {
                      "type": "string"
                    },
                    "synthetic": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "verified",
                    "identity_reference",
                    "consent_reference",
                    "synthetic"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Staff login required"
          },
          "403": {
            "description": "Role or CSRF rejected"
          },
          "409": {
            "description": "State or idempotency conflict"
          }
        }
      }
    },
