{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOCAL SIMULATION payment",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "failed"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "synthetic": {
      "type": "boolean",
      "enum": [
        true
      ]
    }
  },
  "required": [
    "status",
    "reason_code",
    "synthetic"
  ]
}