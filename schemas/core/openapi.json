  "components": {
    "schemas": {
      "ApplicationDecision": {
        "properties": {
          "expected_status": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Expected Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_status"
        ],
        "title": "ApplicationDecision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProgrammeCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "mnemonic": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_]+$",
            "title": "Mnemonic"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "max_income": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Max Income"
          },
          "min_members": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Min Members"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "mnemonic",
          "amount",
          "max_income",
          "min_members"
        ],
        "title": "ProgrammeCreate"
      },
      "ProgrammeUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "max_income": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Max Income"
          },
          "min_members": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Min Members"
          },
          "status": {
            "type": "string",
            "pattern": "^(ACTIVE|PAUSED|CLOSED)$",
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "amount",
          "max_income",
          "min_members",
          "status",
          "version"
        ],
        "title": "ProgrammeUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
